{{ if eq .chromium.api_key "" }}
.config/environment.d/50-chromium-oauth.conf
{{ end }}
{{ if eq .restic.repository "" }}
.config/restic/env
.config/systemd/user/restic-backup.service
.config/systemd/user/restic-backup.timer
{{ end }}
{{ if eq (dig "ollama" "api_key" "" .) "" }}
.config/environment.d/60-ollama.conf
{{ end }}

# Python bytecode (created at runtime next to ~/.local/lib/fw13; never part of the source)
.local/lib/**/__pycache__
.local/lib/**/__pycache__/**

# Remote Desktop Manager launcher (through fw-rdm) only when it's installed (group `remote`)
{{ if not (lookPath "remotedesktopmanager") }}
.local/share/applications/com.devolutions.remotedesktopmanager.desktop
{{ end }}
# DBeaver launcher + first-run dark theme only when it's installed (group `database`)
{{ if not (lookPath "dbeaver-ce") }}
.local/share/applications/dbeaver-ce.desktop
.local/share/DBeaverData
.local/share/DBeaverData/**
{{ end }}
