[Desktop Entry]
# Overrides /etc/xdg/autostart/blueman.desktop (uwsm runs it) where blueman is still installed (no longer in the
# package lists): fw-bt-agent is the pairing agent in Hyprland and the bar has the Bluetooth menu. Other desktops unchanged.
Name=Blueman Applet
Comment=Blueman Bluetooth Manager
Icon=blueman
Exec=blueman-applet
Terminal=false
Type=Application
Categories=
NotShowIn=Hyprland;
