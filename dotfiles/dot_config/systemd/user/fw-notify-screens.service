[Unit]
Description=fw13 notifications on the screen of the app that sent them (Hyprland only)
# The condition skips it (no failure) outside Hyprland.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecCondition=%h/.local/bin/fw-notify-screens enabled
ExecStart=%h/.local/bin/fw-notify-screens
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
