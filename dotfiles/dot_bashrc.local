# Sourced from ~/.bashrc (Fedora default) via the line chezmoi appends below
command -v mise >/dev/null && eval "$(mise activate bash)"  # also for non-interactive bash (ssh host cmd)
[[ $- == *i* ]] || return 0  # the rest is for typing at a prompt only

# History: big, no duplicates, written after every command and shared between open terminals
HISTSIZE=50000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups  # also skips commands typed with a leading space
HISTTIMEFORMAT='%F %T  '
shopt -s histappend cmdhist
PROMPT_COMMAND="history -a; history -n${PROMPT_COMMAND:+; $PROMPT_COMMAND}"  # before starship, which appends its own

# Tab completion: case-insensitive, list on the first Tab, Tab / Shift+Tab cycle through the matches
bind 'set completion-ignore-case on'
bind 'set show-all-if-ambiguous on'
bind 'set colored-stats on'
bind 'set mark-symlinked-directories on'
bind 'TAB: menu-complete'
bind '"\e[Z": menu-complete-backward'
bind 'set menu-complete-display-prefix on'

# fzf: Ctrl+R history search, Ctrl+T insert a file, Alt+C cd into a folder; files listed by fd (skips .git, .gitignore)
if command -v fzf >/dev/null; then
  eval "$(fzf --bash)"
  if command -v fd >/dev/null; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
    export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND
    export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
  fi
fi

# Dim key hint at the right of the prompt; Settings → Appearance → Terminal → Key hints writes the off marker
if [[ -e ${XDG_CONFIG_HOME:-$HOME/.config}/fw13/terminal-hints-off ]]; then
  unset FW13_KEY_HINTS
else
  export FW13_KEY_HINTS='Ctrl+R history · Ctrl+T file · Alt+C folder'
fi

# Aliases
alias ll='ls -lh --group-directories-first'
alias la='ls -lAh --group-directories-first'
alias ..='cd ..'
alias ...='cd ../..'
mkcd() { mkdir -p -- "$1" && cd -- "$1"; }
# cat with syntax colours when bat is installed (not part of the install); plain cat when piped
command -v bat >/dev/null && alias cat='bat --paging=never --style=plain'

command -v starship >/dev/null && eval "$(starship init bash)"
