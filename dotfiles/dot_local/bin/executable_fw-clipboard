#!/usr/bin/env bash
# Clipboard history (SUPER+V): pick an entry → it's copied and pasted into the window you were in.
# Paste = fw-clip-key paste (Hyprland's send_shortcut, no extra tool): Ctrl+Shift+V in terminals, Ctrl+V elsewhere.
set -euo pipefail

addr="$(hyprctl activewindow | awk '/^Window / { print $2; exit }')"

pick="$(cliphist list | fuzzel --dmenu --prompt 'Clipboard › ' --width 60)" || exit 0
[[ -n $pick ]] || exit 0
cliphist decode <<<"$pick" | wl-copy >/dev/null 2>&1  # wl-copy stays running to serve the clipboard

[[ -n $addr ]] || exit 0  # empty workspace: just copied
sleep 0.1  # let fuzzel close and the clipboard settle
FW_CLIP_WINDOW="${addr#0x}" fw-clip-key paste
