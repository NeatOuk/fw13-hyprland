#!/usr/bin/env python3
"""Settings — fw13-hypr's own settings app (flat, GTK3; colours follow the desktop theme and recolour live).
Tiles like any app (no window rule). Header: Framework gear + title, a search box and a close button. Search covers
every heading and row of every page (pages/search.py over page.index; the first search builds the unopened pages
one per idle callback): the sidebar keeps the pages with a match, the page area lists "Page › Section › Row";
a click (Enter = the first) opens the page, scrolls to the row and highlights it. Ctrl+F focuses the box,
Esc clears it, Esc again closes.

  fw-settings [page]          open (or focus the open window) at a page: network bluetooth sound display
                              power appearance input jarvis security system apps fw13 (keys, backups, login shell — what the
                              installer asked once)
  fw-settings --toggle [page] bar sliders icon: close it if it's open and focused, else open/focus

Single instance via Gtk.Application (D-Bus id land.fw13.Settings): a second call just forwards its arguments.
Pages live in ~/.local/lib/fw13/pages; backends in ~/.local/lib/fw13 (shared with the bar panels).
"""
import importlib
import os
import sys
import time
import traceback

sys.path.insert(0, os.path.expanduser("~/.local/lib"))

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

from fw13 import ui_theme  # noqa: E402
from fw13.pages import PAGES, search  # noqa: E402
from fw13.pages.common import Page  # noqa: E402


class SettingsWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Settings")
        self.set_default_size(980, 680)
        self.pages = {}
        self.current = None
        self.hits = []
        self.hit_pages = set()
        self.indexing = None  # pages still to build for the search index; None = not started
        self.rerun = None
        self.pending = None  # (page id, section, text, until): the hit to reveal again after a re-render
        self.reveal_id = None
        Page.on_index = self.index_changed

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.pack_start(self.header(), False, False, 0)
        outer.pack_start(Gtk.Separator(), False, False, 0)
        root = Gtk.Box()
        self.sidebar = Gtk.ListBox()
        self.sidebar.get_style_context().add_class("sidebar")
        self.sidebar.set_size_request(200, -1)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.NONE)
        for pid, icon, title, _mod in PAGES:
            row = Gtk.ListBoxRow()
            row.page_id, row.title = pid, title.lower()
            row.add(ui_theme.label(f"{icon}   {title}"))
            self.sidebar.add(row)
        self.sidebar.connect("row-selected", lambda _l, row: row and self.show_page(row.page_id))
        self.sidebar.set_filter_func(lambda row: not self.query or row.page_id in self.hit_pages)
        self.results = Gtk.ListBox()
        for side in ("top", "bottom", "start", "end"):
            getattr(self.results, f"set_margin_{side}")(16)
        self.results.connect("row-activated", lambda _l, row: self.open_hit(row.hit))
        scroll = Gtk.ScrolledWindow()
        scroll.get_style_context().add_class("page")
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(self.results)
        self.stack.add_named(scroll, "search")
        root.pack_start(self.sidebar, False, False, 0)
        root.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 0)
        root.pack_start(self.stack, True, True, 0)
        outer.pack_start(root, True, True, 0)
        self.add(outer)
        self.connect("key-press-event", self.on_key)
        self.connect("delete-event", self.on_close)

    def header(self):
        box = Gtk.Box(spacing=10)
        box.get_style_context().add_class("header")
        logo = Gtk.Image()
        path = os.path.expanduser("~/.config/fw13/theme/framework-logo.svg")  # accent colour, by fw13.theme

        def load_logo():
            logo.set_from_file(path) if os.path.isfile(path) else logo.clear()
        load_logo()
        ui_theme.watch(logo, load_logo)  # a theme change rewrites the logo in the new accent
        box.pack_start(logo, False, False, 0)
        box.pack_start(ui_theme.label("Settings", "title"), False, False, 0)
        self.query = ""
        self.search = Gtk.SearchEntry(placeholder_text="Search settings")
        self.search.set_size_request(320, -1)
        self.search.connect("search-changed", self.on_search)
        self.search.connect("activate", lambda _e: self.open_first())
        box.set_center_widget(self.search)
        box.pack_end(ui_theme.button("\uf00d", self.close), False, False, 0)  # Font Awesome xmark
        return box

    def on_search(self, entry):
        self.query = entry.get_text().strip().lower()
        self.update_results()
        if not self.query:
            self.stack.set_visible_child_name(self.current or "network")
            return
        self.stack.set_visible_child_name("search")
        if self.indexing is None:
            self.indexing = [p for p, *_ in PAGES if p not in self.pages]
            GLib.idle_add(self.index_next, priority=GLib.PRIORITY_LOW)

    def index_next(self):
        """Build one unopened page so its rows are searchable; one per idle call keeps typing smooth."""
        if self.indexing:
            pid = self.indexing.pop(0)
            if pid not in self.pages:
                try:
                    self.build_page(pid)
                except Exception:  # one broken page must not stop the index of the others
                    print(f"fw-settings: page {pid} failed to build for search:", file=sys.stderr)
                    traceback.print_exc()
        if not self.indexing and self.query:
            self.update_results()  # "Searching…" → "Nothing found" even if no page rendered at the end
        return bool(self.indexing)

    def index_changed(self):
        """A page added rows (built for the index, or an async render): refresh the results shortly."""
        if self.pending and time.monotonic() < self.pending[3]:
            self.schedule_reveal()  # the opened page re-rendered (refresh() → background load): find the row again
        if self.query and not self.rerun:
            self.rerun = GLib.timeout_add(200, self.rerun_search)

    def rerun_search(self):
        self.rerun = None
        self.update_results()
        return False

    def update_results(self):
        self.hits = search.hits(self.query, self.pages)
        self.hit_pages = {h[0] for h in self.hits}  # a page whose name matches is a hit of its own
        self.sidebar.invalidate_filter()
        for child in self.results.get_children():
            self.results.remove(child)
        if self.query and not self.hits:
            self.results.add(ui_theme.label("Nothing found" if not self.indexing else "Searching\u2026", "dim"))
        for hit in self.hits[:60]:
            row = Gtk.ListBoxRow()
            row.hit = hit
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            box.get_style_context().add_class("item")
            box.pack_start(ui_theme.label(search.label(hit)), False, False, 0)
            if hit[3]:
                box.pack_start(ui_theme.label(hit[3], "dim", wrap=True), False, False, 0)
            row.add(box)
            self.results.add(row)
        self.results.show_all()

    def open_first(self):
        if self.hits:
            self.open_hit(self.hits[0])

    def open_hit(self, hit):
        pid, section, text, _hint = hit
        self.show_page(pid)
        if section or text:
            self.pending = (pid, section, text, time.monotonic() + 3)
            self.schedule_reveal()

    def schedule_reveal(self):
        """Reveal the pending hit once the page has been laid out and has stopped re-rendering (debounced)."""
        if self.reveal_id:
            GLib.source_remove(self.reveal_id)
        self.reveal_id = GLib.timeout_add(150, self.reveal)

    def reveal(self):
        self.reveal_id = None
        pid, section, text, _until = self.pending
        page = self.pages[pid]
        w = search.find(page, section, text)
        pos = w and w.get_parent() and w.translate_coordinates(page.box, 0, 0)
        if not pos:
            return False
        adj = page.get_vadjustment()
        adj.set_value(min(max(pos[1] - 24, 0), adj.get_upper() - adj.get_page_size()))
        w.get_style_context().add_class("found")
        GLib.timeout_add(1600, lambda: w.get_style_context().remove_class("found") and False)
        return False

    def on_key(self, _w, e):
        if e.keyval in (Gdk.KEY_f, Gdk.KEY_F) and e.state & Gdk.ModifierType.CONTROL_MASK:
            self.search.grab_focus()
            return True
        if e.keyval == Gdk.KEY_Escape:
            if self.search.get_text():
                self.search.set_text("")
            else:
                self.close()
            return True
        return False

    def build_page(self, pid):
        mod = next(m for p, _i, _t, m in PAGES if p == pid)
        page = importlib.import_module(f"fw13.pages.{mod}").build()
        self.pages[pid] = page
        self.stack.add_named(page, pid)
        page.show_all()

    def show_page(self, pid):
        if pid not in self.pages:  # build lazily: a slow page doesn't delay opening Settings
            self.build_page(pid)
        else:
            self.pages[pid].refresh()
        self.current = pid
        self.stack.set_visible_child_name(pid)
        row = next(r for r in self.sidebar.get_children() if r.page_id == pid)
        if self.sidebar.get_selected_row() is not row:
            self.sidebar.select_row(row)

    def on_close(self, *_):
        for page in self.pages.values():
            if hasattr(page, "closing"):
                page.closing()  # e.g. Display reverts an unconfirmed layout
        return False


class SettingsApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="land.fw13.Settings",
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        ui_theme.install()

    def do_command_line(self, cmdline):
        args = [a for a in cmdline.get_arguments()[1:]]
        toggle = "--toggle" in args
        args = [a for a in args if not a.startswith("--")]
        page = args[0] if args and args[0] in {p for p, *_ in PAGES} else None
        if toggle and self.win and self.win.is_active():
            self.win.close()
            return 0
        if not self.win:
            self.win = SettingsWindow(self)
            self.win.connect("destroy", lambda _w: setattr(self, "win", None))
            self.win.show_all()
            page = page or "network"
        if page:
            self.win.show_page(page)
        self.win.present_with_time(GLib.get_monotonic_time() // 1000)
        return 0


if __name__ == "__main__":
    sys.exit(SettingsApp().run(sys.argv))
