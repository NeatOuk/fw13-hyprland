#!/usr/bin/env python3
"""Claude plan limits (5-hour / weekly / monthly spend) in the bar.

  fw-claude-limits --statusline   Claude Code statusLine command: saves rate_limits, prints 3 lines (model · effort ·
                                  advisor / folder ⎇ branch · context · cost · time · lines / 5h + 7d gauges)
  fw-claude-limits --bar          waybar JSON (icon only; yellow ≥ 75 %, red ≥ 90 %; tooltip = details)
  fw-claude-limits                panel (bar icon with FW_BAR=1 → opens below it)

The only documented source of plan limits is the statusLine JSON (code.claude.com/docs/en/statusline,
Claude Code ≥ 2.1.251, Pro/Max), so the numbers refresh while Claude Code runs; the panel says how old they are.
5h/7d are links to claude.ai's usage page. Nothing else is clickable: Claude Code opens clicked links itself and only
for an allowlist of schemes (https, editors, …), so links to our own handlers are refused.
The advisor isn't in the statusLine JSON: it's read from the settings files (`advisorModel`, saved by /advisor).
"""
import json
import os
import re
import subprocess
import sys
import time

CACHE = os.path.expanduser("~/.cache/fw-claude/limits.json")
ICON = "✱"
PERIOD = {"daily": "today", "weekly": "this week", "monthly": "this month"}


def load():
    try:
        return json.load(open(CACHE))
    except (OSError, ValueError):
        return None


def pct(block):
    return block.get("used_percentage") if isinstance(block, dict) else None


def ago(ts):
    m = int((time.time() - ts) // 60)
    if m < 1:
        return "just now"
    if m < 60:
        return f"{m} min ago"
    return f"{m // 60} h {m % 60} min ago" if m < 1440 else time.strftime("%a %H:%M", time.localtime(ts))


def resets(ts):
    if not ts:
        return ""
    left = int(ts - time.time())
    when = time.strftime("%H:%M" if left < 86400 else "%a %H:%M", time.localtime(ts))
    if left <= 0:
        return f"reset at {when}"
    h, m = divmod(left // 60, 60)
    return f"resets {when} (in {h} h {m} min)" if h else f"resets {when} (in {m} min)"


def gauge(p, width=10):
    filled = round(min(max(p, 0), 100) / 100 * width)
    return "█" * filled + "░" * (width - filled)


# --- statusLine ---------------------------------------------------------------------------------
# Basic ANSI colours, so the terminal theme (fw13 theme files) decides the actual shades
C = {"dim": "2", "bold": "1", "red": "31", "green": "32", "yellow": "33", "blue": "34", "magenta": "1;35"}
USAGE = "https://claude.ai/settings/usage"


def paint(text, color, link=None):
    out = f"\033[{C[color]}m{text}\033[0m"
    return f"\033]8;;{link}\033\\{out}\033]8;;\033\\" if link else out


def level(p, warn=75, crit=90):
    return "red" if p >= crit else "yellow" if p >= warn else "green"


def short(seconds):
    m = max(int(seconds), 0) // 60
    d, h, m = m // 1440, m // 60 % 24, m % 60
    return f"{d}d{h}h" if d else f"{h}h{m:02d}m" if h else f"{m}m"


def advisor(cwd):
    """advisorModel from the settings files (later wins, as Claude Code merges them); None = off."""
    val = None
    for f in (os.path.expanduser("~/.claude/settings.json"), os.path.join(cwd, ".claude/settings.json"),
              os.path.join(cwd, ".claude/settings.local.json")):
        try:
            val = json.load(open(f)).get("advisorModel", val)
        except (OSError, ValueError, AttributeError):
            continue
    return val


def git(cwd):
    """(branch, dirty) or None outside a repo."""
    try:
        b = subprocess.run(["git", "-C", cwd, "branch", "--show-current"], capture_output=True, text=True, timeout=1)
        if b.returncode:
            return None
        d = subprocess.run(["git", "-C", cwd, "status", "--porcelain"], capture_output=True, text=True, timeout=1)
        return b.stdout.strip() or "detached", bool(d.stdout.strip())
    except (OSError, subprocess.SubprocessError):
        return None


def lines(data, branch, adv, now):
    """The three status lines (pure)."""
    rl = data.get("rate_limits") or {}
    effort = (data.get("effort") or {}).get("level")
    one = [paint((data.get("model") or {}).get("display_name", "Claude"), "magenta")]
    if effort:
        one.append(paint(f"effort {effort}", "blue"))
    one.append(paint(f"advisor {re.sub(r'^claude-', '', adv) if adv else 'off'}", "blue" if adv else "dim"))
    cwd = (data.get("workspace") or {}).get("current_dir") or data.get("cwd") or ""
    two = [paint(os.path.basename(cwd) or cwd, "blue")] if cwd else []
    if branch:
        name, dirty = branch
        two[-1:] = [" ".join(two[-1:] + [paint(f"⎇ {name}{'*' if dirty else ''}", "yellow" if dirty else "green")])]
    ctx = (data.get("context_window") or {}).get("used_percentage")
    if ctx is not None:
        two.append(paint(f"ctx {ctx:.0f}%", level(ctx, 50, 80)))
    cost = data.get("cost") or {}
    if cost.get("total_cost_usd") is not None:
        two.append(paint(f"${cost['total_cost_usd']:.2f}", "dim"))
    if cost.get("total_duration_ms"):
        two.append(paint(short(cost["total_duration_ms"] / 1000), "dim"))
    if cost.get("total_lines_added") is not None:
        two.append(paint(f"+{cost['total_lines_added']}", "green") + " "
                   + paint(f"−{cost.get('total_lines_removed', 0)}", "red"))
    three = []
    for key, label in (("five_hour", "5h"), ("seven_day", "7d")):
        b = rl.get(key)
        p = pct(b)
        if p is None:
            continue
        filled = round(min(max(p, 0), 100) / 10)
        part = paint(label, "bold", USAGE) + " " + paint("▰" * filled + "▱" * (10 - filled), level(p)) \
            + f" {p:>3.0f}%"
        if b.get("resets_at"):
            part += " " + paint(f"↻ {short(b['resets_at'] - now)}", "dim")
        three.append(part)
    dot = paint(" · ", "dim")
    return [dot.join(x) for x in (one, two, three) if x]


def statusline():
    try:
        data = json.load(sys.stdin)
    except ValueError:
        data = {}
    rl = data.get("rate_limits")
    if rl:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        tmp = CACHE + ".tmp"
        json.dump({"updated": time.time(), "rate_limits": rl}, open(tmp, "w"))
        os.replace(tmp, CACHE)
    cwd = (data.get("workspace") or {}).get("current_dir") or data.get("cwd") or os.getcwd()
    print("\n".join(lines(data, git(cwd), advisor(cwd), time.time())))


def selftest():
    data = {"model": {"display_name": "Opus 5.5"}, "effort": {"level": "medium"},
            "workspace": {"current_dir": "/h/proj"}, "context_window": {"used_percentage": 14},
            "cost": {"total_cost_usd": 1.2, "total_duration_ms": 2040000, "total_lines_added": 120,
                     "total_lines_removed": 14},
            "rate_limits": {"five_hour": {"used_percentage": 1, "resets_at": 1000 + 4 * 3600 + 720},
                            "seven_day": {"used_percentage": 84, "resets_at": 1000 + 2 * 86400 + 5 * 3600}}}
    plain = [re.sub(r"\x1b\]8;;[^\x1b]*\x1b\\|\x1b\[[0-9;]*m", "", x)
             for x in lines(data, ("main", True), None, 1000)]
    assert plain == ["Opus 5.5 · effort medium · advisor off", "proj ⎇ main* · ctx 14% · $1.20 · 34m · +120 −14",
                     "5h ▱▱▱▱▱▱▱▱▱▱   1% ↻ 4h12m · 7d ▰▰▰▰▰▰▰▰▱▱  84% ↻ 2d5h"], plain
    out = "".join(lines(data, ("main", False), "claude-fable-5-1", 1000))
    assert "advisor fable-5-1" in out and USAGE in out
    assert len(lines({}, None, None, 0)) == 1  # empty input: model line only
    print("fw-claude-limits: ok")


# --- bar ----------------------------------------------------------------------------------------
def bar():
    d = load()
    if not d:
        print(json.dumps({"text": ICON, "tooltip": "Claude limits: open Claude Code once to load them"}))
        return
    rl = d["rate_limits"]
    vals = [p for p in (pct(rl.get("five_hour")), pct(rl.get("seven_day"))) if p is not None]
    top = max(vals) if vals else 0
    lines = []
    for key, label in (("five_hour", "5-hour"), ("seven_day", "Weekly")):
        b = rl.get(key)
        if pct(b) is not None:
            lines.append(f"{label}: {pct(b):.0f}% · {resets(b.get('resets_at'))}")
    lines.append(f"Updated {ago(d['updated'])}")
    cls = "critical" if top >= 90 else "warning" if top >= 75 else ""
    print(json.dumps({"text": ICON, "tooltip": "\n".join(lines), "class": cls}))  # % only in the panel


# --- panel --------------------------------------------------------------------------------------
def panel():
    pos = []
    if os.environ.get("FW_BAR"):
        pos = [p for p in subprocess.run(["fw-menu-anchor", "claude"], capture_output=True,
                                         text=True).stdout.split("\n") if p]
        if not pos:
            return  # second click on the icon: menu closed
    d = load()
    rows = []
    if d:
        rl = d["rate_limits"]
        for key, label in (("five_hour", "5-hour"), ("seven_day", "Weekly")):
            b = rl.get(key)
            if pct(b) is not None:  # gauge line, then the reset time underneath
                rows.append(f"{label:<7} {gauge(pct(b), 24)}  {pct(b):>3.0f}%")
                rows.append(f"        {resets(b.get('resets_at'))}")
        s = rl.get("spend_limit")
        if isinstance(s, dict) and s.get("limit_usd"):
            rows.append(f"Spend   ${s.get('used_usd', 0):.0f} of ${s['limit_usd']:.0f}"
                        f" ({pct(s) or 0:.0f}%) {PERIOD.get(s.get('period'), '')}".rstrip())
        rows.append(f"Updated {ago(d['updated'])}")
    else:
        rows.append("Open Claude Code once to load your limits")
    rows.append(f"{ICON}  Open Claude Code")
    r = subprocess.run(["fuzzel", "--dmenu", *pos, "--prompt", "Claude › ", "--lines", str(len(rows)),
                        "--width", "44"], input="\n".join(rows), capture_output=True, text=True)
    if r.returncode == 0 and r.stdout.strip().endswith("Open Claude Code"):
        subprocess.Popen(["uwsm", "app", "--", "fw-term", "-e", "claude"], cwd=os.path.expanduser("~"),
                         start_new_session=True)


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    {"--statusline": statusline, "--bar": bar, "test": selftest}.get(arg, panel)()
    return 0


if __name__ == "__main__":
    sys.exit(main())
