#!/usr/bin/env python3
"""Claude plan limits (5-hour / weekly / monthly spend) in the bar.

  fw-claude-limits --statusline   Claude Code statusLine command: saves rate_limits, prints 6 "Label: value" lines
                                  (Claude settings / session / repo / context + cache / 5h + 7d limits / laptop)
  fw-claude-limits --bar          waybar JSON (icon only; yellow ≥ 75 %, red ≥ 90 %; tooltip = details)
  fw-claude-limits                panel (bar icon with FW_BAR=1 → opens below it)

The only documented source of plan limits is the statusLine JSON (code.claude.com/docs/en/statusline,
Claude Code ≥ 2.1.251, Pro/Max), so the numbers refresh while Claude Code runs; the panel says how old they are.
5h/7d are links to claude.ai's usage page. Nothing else is clickable: Claude Code opens clicked links itself and only
for an allowlist of schemes (https, editors, …), so links to our own handlers are refused.
The advisor isn't in the statusLine JSON: it's read from the settings files (`advisorModel`, saved by /advisor).
"""
import glob
import json
import os
import re
import subprocess
import sys
import time

CACHE = os.path.expanduser("~/.cache/fw-claude/limits.json")
ICON = "✱"
PERIOD = {"daily": "today", "weekly": "this week", "monthly": "this month"}


def load():
    try:
        return json.load(open(CACHE))
    except (OSError, ValueError):
        return None


def pct(block):
    return block.get("used_percentage") if isinstance(block, dict) else None


def ago(ts):
    m = int((time.time() - ts) // 60)
    if m < 1:
        return "just now"
    if m < 60:
        return f"{m} min ago"
    return f"{m // 60} h {m % 60} min ago" if m < 1440 else time.strftime("%a %H:%M", time.localtime(ts))


def resets(ts):
    if not ts:
        return ""
    left = int(ts - time.time())
    when = time.strftime("%H:%M" if left < 86400 else "%a %H:%M", time.localtime(ts))
    if left <= 0:
        return f"reset at {when}"
    h, m = divmod(left // 60, 60)
    return f"resets {when} (in {h} h {m} min)" if h else f"resets {when} (in {m} min)"


def gauge(p, width=10):
    filled = round(min(max(p, 0), 100) / 100 * width)
    return "█" * filled + "░" * (width - filled)


# --- statusLine ---------------------------------------------------------------------------------
# Basic ANSI colours, so the terminal theme (fw13 theme files) decides the actual shades
C = {"dim": "2", "bold": "1", "red": "31", "green": "32", "yellow": "33", "blue": "34", "magenta": "1;35",
     "cyan": "36", "label": "LBL"}  # "label": swapped for the line's label colour in lines()
# label colour per line (Claude, session, repo, context, limits, laptop): each line its own hue
LABELS = ("2;35", "2;34", "2;36", "2;32", "2;33", "2;36")  # faint, so values in the same hue still stand out
USAGE = "https://claude.ai/settings/usage"


def paint(text, color, link=None):
    out = f"\033[{C[color]}m{text}\033[0m"
    return f"\033]8;;{link}\033\\{out}\033]8;;\033\\" if link else out


def level(p, warn=75, crit=90):
    return "red" if p >= crit else "yellow" if p >= warn else "green"


def short(seconds):
    m = max(int(seconds), 0) // 60
    d, h, m = m // 1440, m // 60 % 24, m % 60
    return f"{d}d{h}h" if d else f"{h}h{m:02d}m" if h else f"{m}m"


def advisor(cwd):
    """advisorModel from the settings files (later wins, as Claude Code merges them); None = off."""
    val = None
    for f in (os.path.expanduser("~/.claude/settings.json"), os.path.join(cwd, ".claude/settings.json"),
              os.path.join(cwd, ".claude/settings.local.json")):
        try:
            val = json.load(open(f)).get("advisorModel", val)
        except (OSError, ValueError, AttributeError):
            continue
    return val


def git(cwd):
    """{branch, changed, ahead, behind, last} or None outside a repo (2 git calls, 1 s cap each). No optional locks:
    status runs at every redraw and must never hold index.lock while a commit runs."""
    try:
        st = subprocess.run(["git", "--no-optional-locks", "-C", cwd, "status", "--porcelain=v2", "--branch"], capture_output=True,
                            text=True, timeout=1)
        if st.returncode:
            return None
        info = {"branch": "detached", "changed": 0, "ahead": None, "behind": None, "last": None}
        for ln in st.stdout.splitlines():
            if ln.startswith("# branch.head ") and ln[14:] != "(detached)":
                info["branch"] = ln[14:]
            elif ln.startswith("# branch.ab "):
                a, b = ln.split()[2:4]
                info["ahead"], info["behind"] = int(a), -int(b)
            elif not ln.startswith("#"):
                info["changed"] += 1
        lg = subprocess.run(["git", "-C", cwd, "log", "-1", "--format=%ct"], capture_output=True, text=True,
                            timeout=1)
        info["last"] = int(lg.stdout) if lg.stdout.strip().isdigit() else None
        return info
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


CPU = os.path.expanduser("~/.cache/fw-claude/cpu.json")


def cpu_percent():
    """Busy % since the previous status line (the last /proc/stat sample is kept in CPU); None on the first call."""
    try:
        f = [int(x) for x in open("/proc/stat").readline().split()[1:]]
    except (OSError, ValueError):
        return None
    total, idle = sum(f), f[3] + f[4]
    try:
        prev = json.load(open(CPU))
    except (OSError, ValueError):
        prev = None
    try:
        json.dump([total, idle], open(CPU, "w"))
    except OSError:
        pass
    if not prev or total <= prev[0]:
        return None
    return 100 * (1 - (idle - prev[1]) / (total - prev[0]))


def laptop():
    """{battery, charging, cpu, ram_used, ram_total, disk_free, syncthing}: values that can't be read are left out."""
    out = {}
    for bat in sorted(glob.glob("/sys/class/power_supply/BAT*")):
        try:
            out["battery"] = int(open(f"{bat}/capacity").read())
            # plugged in = the AC adapter's online flag: with a charge limit the battery says "Not charging" on AC
            out["charging"] = any(open(f).read().strip() == "1" for f in glob.glob("/sys/class/power_supply/AC*/online"))
        except (OSError, ValueError):
            pass
        break
    out["cpu"] = cpu_percent()
    try:
        mem = {ln.split(":")[0]: int(ln.split()[1]) for ln in open("/proc/meminfo")}
        out["ram_total"], out["ram_used"] = mem["MemTotal"] / 2**20, (mem["MemTotal"] - mem["MemAvailable"]) / 2**20
    except (OSError, ValueError, KeyError, IndexError):
        pass
    try:
        st = os.statvfs(os.path.expanduser("~"))
        out["disk_free"] = st.f_bavail * st.f_frsize / 1e9
    except OSError:
        pass
    try:  # fw-syncthing's bar state: idle / syncing / error / paused / stopped
        sync = json.load(open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "fw-syncthing.json")))
        out["syncthing"] = (sync.get("class"), sync.get("text", ""))
    except (OSError, ValueError, AttributeError):
        pass
    return {k: v for k, v in out.items() if v is not None}


def kv(label, value, link=None):
    """"Label: value" with the label in its line's colour (value already painted)."""
    return paint(f"{label}:", "label", link) + " " + value


def onoff(flag):
    return paint("on", "green") if flag else paint("off", "dim")


def gauge10(p, warn=75, crit=90):
    filled = round(min(max(p, 0), 100) / 10)
    # thin rules, not full blocks: █ fills the whole cell and touches the rows above/below with taller line spacing
    return paint("━" * filled, level(p, warn, crit)) + paint("─" * (10 - filled), "dim") + f"  {p:.0f}%"


def tokens(n):
    return f"{n / 1e6:g}M" if n >= 1e6 else f"{n / 1e3:.0f}k" if n >= 1e3 else str(n)


SYNC = {"idle": ("up to date", "green"), "error": ("problems", "red"), "paused": ("paused", "yellow"),
        "stopped": ("off", "dim")}


def lines(data, repo, adv, lap, now):
    """The six status lines (pure): Label: value items joined by dim dots; missing data is left out."""
    get = lambda *keys: [(data.get(k) or {}) for k in keys]  # noqa: E731
    model, effort, think, style, cost, cw, pc = get("model", "effort", "thinking", "output_style", "cost",
                                                    "context_window", "prompt_cache")
    one = [kv("Model", paint(model.get("display_name", "Claude"), "magenta"))]
    if effort.get("level"):
        one.append(kv("Effort", paint(effort["level"], "blue")))
    one.append(kv("Advisor", paint(re.sub(r"^claude-", "", adv), "blue") if adv else paint("off", "dim")))
    if "enabled" in think:
        one.append(kv("Thinking", onoff(think["enabled"])))
    if "fast_mode" in data:
        one.append(kv("Fast", onoff(data["fast_mode"])))
    if style.get("name"):
        one.append(kv("Style", paint(style["name"], "cyan")))
    if data.get("version"):
        one.append(paint(f"v{data['version']}", "dim"))

    two = [kv("Session", paint(data["session_name"], "blue"))] if data.get("session_name") else []
    if cost.get("total_duration_ms"):
        two.append(kv("Open", paint(short(cost["total_duration_ms"] / 1000), "cyan")))
    if cost.get("total_api_duration_ms"):
        two.append(kv("Working", paint(short(cost["total_api_duration_ms"] / 1000), "cyan")))
    if cost.get("total_cost_usd") is not None:
        two.append(kv("Cost", paint(f"${cost['total_cost_usd']:.2f}", "yellow")))
    if cost.get("total_lines_added") is not None:
        two.append(kv("Lines", paint(f"+{cost['total_lines_added']}", "green") + " "
                      + paint(f"−{cost.get('total_lines_removed', 0)}", "red")))

    ws = data.get("workspace") or {}
    cwd = ws.get("current_dir") or data.get("cwd") or ""
    gh = ws.get("repo") or {}
    name = f"{gh['owner']}/{gh['name']}" if gh.get("owner") and gh.get("name") else os.path.basename(cwd) or cwd
    three = [kv("Repo" if repo else "Folder", paint(name, "blue"))] if name else []
    if repo:
        three.append(kv("Branch", paint(repo["branch"] + ("*" if repo["changed"] else ""),
                                        "yellow" if repo["changed"] else "green")))
        if repo["ahead"] is not None:
            three.append(kv("Unpushed", paint(str(repo["ahead"]), "yellow" if repo["ahead"] else "dim")))
            if repo["behind"]:  # only when there is something to pull: keeps the line short
                three.append(kv("Behind", paint(str(repo["behind"]), "yellow")))
        n = repo["changed"]
        three.append(kv("Changed", paint(f"{n} file{'s' if n != 1 else ''}", "yellow") if n else paint("clean", "green")))
        if repo["last"]:
            age = now - repo["last"]
            three.append(kv("Last commit", paint("just now" if age < 60 else short(age) + " ago", "cyan")))

    four = []
    if cw.get("used_percentage") is not None:
        ctx = gauge10(cw["used_percentage"], 50, 80)
        if cw.get("total_input_tokens") and cw.get("context_window_size"):
            ctx += paint(f" ({tokens(cw['total_input_tokens'])} / {tokens(cw['context_window_size'])})", "dim")
        four.append(kv("Context", ctx))
    if "warm" in pc:
        cache = paint("warm", "green") if pc["warm"] else paint("cold", "yellow")
        if pc.get("hit_ratio") is not None:
            cache += ", " + paint(f"{pc['hit_ratio'] * 100:.0f}% hits", "cyan")
        if pc["warm"] and pc.get("expires_at"):
            cache += paint(f" (expires in {short(pc['expires_at'] - now)})", "dim")
        four.append(kv("Cache", cache))

    five = []
    for key, label in (("five_hour", "5h"), ("seven_day", "7d")):
        b = (data.get("rate_limits") or {}).get(key)
        if pct(b) is None:
            continue
        val = gauge10(pct(b))
        if b.get("resets_at"):
            val += " " + paint(f"(resets in {short(b['resets_at'] - now)})", "dim")
        five.append(kv(label, val, USAGE))

    six = []
    if "battery" in lap:
        b = lap["battery"]
        six.append(kv("Battery", paint(f"{b}%", "green" if b > 30 else "yellow" if b > 15 else "red")
                      + (" ⚡" if lap.get("charging") else "")))
    if "cpu" in lap:
        six.append(kv("CPU", paint(f"{lap['cpu']:.0f}%", level(lap["cpu"]))))
    if "ram_used" in lap:
        p = 100 * lap["ram_used"] / lap["ram_total"]
        six.append(kv("RAM", paint(f"{lap['ram_used']:.0f}/{lap['ram_total']:.0f} GB", level(p))))
    if "disk_free" in lap:
        free = lap["disk_free"]
        size = f"{free / 1000:.1f} TB" if free >= 1000 else f"{free:.0f} GB"
        six.append(kv("Disk", paint(f"{size} free", "red" if free < 20 else "green")))
    if "syncthing" in lap:
        cls, text = lap["syncthing"]
        word, color = SYNC.get(cls, (text.split()[-1] if text.split() else "syncing", "blue"))
        six.append(kv("Syncthing", paint(word, color)))

    dot = paint("  ·  ", "dim")  # wide separators give the items room
    return [dot.join(x).replace("\033[LBLm", f"\033[{lbl}m")
            for x, lbl in zip((one, two, three, four, five, six), LABELS) if x]


def statusline():
    try:
        data = json.load(sys.stdin)
    except ValueError:
        data = {}
    rl = data.get("rate_limits")
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    if rl:
        tmp = CACHE + ".tmp"
        json.dump({"updated": time.time(), "rate_limits": rl}, open(tmp, "w"))
        os.replace(tmp, CACHE)
    cwd = (data.get("workspace") or {}).get("current_dir") or data.get("cwd") or os.getcwd()
    print("\n".join(lines(data, git(cwd), advisor(cwd), laptop(), time.time())))


def selftest():
    data = {"model": {"display_name": "Opus 5.5"}, "effort": {"level": "medium"}, "thinking": {"enabled": True},
            "fast_mode": False, "output_style": {"name": "Concise"}, "session_name": "s1", "version": "2.1",
            "workspace": {"current_dir": "/h/proj", "repo": {"owner": "o", "name": "proj"}},
            "context_window": {"used_percentage": 14, "total_input_tokens": 141620, "context_window_size": 1000000},
            "prompt_cache": {"warm": True, "hit_ratio": 0.907, "expires_at": 1000 + 52 * 60},
            "cost": {"total_cost_usd": 1.2, "total_duration_ms": 2040000, "total_api_duration_ms": 600000,
                     "total_lines_added": 120, "total_lines_removed": 14},
            "rate_limits": {"five_hour": {"used_percentage": 1, "resets_at": 1000 + 4 * 3600 + 720},
                            "seven_day": {"used_percentage": 84, "resets_at": 1000 + 2 * 86400 + 5 * 3600}}}
    repo = {"branch": "main", "changed": 3, "ahead": 5, "behind": 0, "last": 1000 - 720}
    lap = {"battery": 82, "charging": True, "cpu": 12.4, "ram_used": 18.2, "ram_total": 62.6, "disk_free": 94.3,
           "syncthing": ("idle", "")}
    plain = [re.sub(r"\x1b\]8;;[^\x1b]*\x1b\\|\x1b\[[0-9;]*m", "", x) for x in lines(data, repo, "fable", lap, 1000)]
    plain = [x.replace("  ·  ", " · ") for x in plain]
    assert plain == [
        "Model: Opus 5.5 · Effort: medium · Advisor: fable · Thinking: on · Fast: off · Style: Concise · v2.1",
        "Session: s1 · Open: 34m · Working: 10m · Cost: $1.20 · Lines: +120 −14",
        "Repo: o/proj · Branch: main* · Unpushed: 5 · Changed: 3 files · Last commit: 12m ago",
        "Context: ━─────────  14% (142k / 1M) · Cache: warm, 91% hits (expires in 52m)",
        "5h: ──────────  1% (resets in 4h12m) · 7d: ━━━━━━━━──  84% (resets in 2d5h)",
        "Battery: 82% ⚡ · CPU: 12% · RAM: 18/63 GB · Disk: 94 GB free · Syncthing: up to date"], plain
    assert USAGE in "".join(lines(data, None, None, {}, 1000))
    assert len(lines({}, None, None, {}, 0)) == 1  # empty input: model line only
    print("fw-claude-limits: ok")


# --- bar ----------------------------------------------------------------------------------------
def bar():
    d = load()
    if not d:
        print(json.dumps({"text": ICON, "tooltip": "Claude limits: open Claude Code once to load them"}))
        return
    rl = d["rate_limits"]
    vals = [p for p in (pct(rl.get("five_hour")), pct(rl.get("seven_day"))) if p is not None]
    top = max(vals) if vals else 0
    lines = []
    for key, label in (("five_hour", "5-hour"), ("seven_day", "Weekly")):
        b = rl.get(key)
        if pct(b) is not None:
            lines.append(f"{label}: {pct(b):.0f}% · {resets(b.get('resets_at'))}")
    lines.append(f"Updated {ago(d['updated'])}")
    cls = "critical" if top >= 90 else "warning" if top >= 75 else ""
    print(json.dumps({"text": ICON, "tooltip": "\n".join(lines), "class": cls}))  # % only in the panel


# --- panel --------------------------------------------------------------------------------------
def panel():
    pos = []
    if os.environ.get("FW_BAR"):
        pos = [p for p in subprocess.run(["fw-menu-anchor", "claude"], capture_output=True,
                                         text=True).stdout.split("\n") if p]
        if not pos:
            return  # second click on the icon: menu closed
    d = load()
    rows = []
    if d:
        rl = d["rate_limits"]
        for key, label in (("five_hour", "5-hour"), ("seven_day", "Weekly")):
            b = rl.get(key)
            if pct(b) is not None:  # gauge line, then the reset time underneath
                rows.append(f"{label:<7} {gauge(pct(b), 24)}  {pct(b):>3.0f}%")
                rows.append(f"        {resets(b.get('resets_at'))}")
        s = rl.get("spend_limit")
        if isinstance(s, dict) and s.get("limit_usd"):
            rows.append(f"Spend   ${s.get('used_usd', 0):.0f} of ${s['limit_usd']:.0f}"
                        f" ({pct(s) or 0:.0f}%) {PERIOD.get(s.get('period'), '')}".rstrip())
        rows.append(f"Updated {ago(d['updated'])}")
    else:
        rows.append("Open Claude Code once to load your limits")
    rows.append(f"{ICON}  Open Claude Code")
    r = subprocess.run(["fuzzel", "--dmenu", *pos, "--prompt", "Claude › ", "--lines", str(len(rows)),
                        "--width", "44"], input="\n".join(rows), capture_output=True, text=True)
    if r.returncode == 0 and r.stdout.strip().endswith("Open Claude Code"):
        subprocess.Popen(["uwsm", "app", "--", "fw-term", "-e", "claude"], cwd=os.path.expanduser("~"),
                         start_new_session=True)


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    {"--statusline": statusline, "--bar": bar, "test": selftest}.get(arg, panel)()
    return 0


if __name__ == "__main__":
    sys.exit(main())
