#!/usr/bin/env bash
# Control center (fuzzel). Bar sliders icon opens the main menu; bar icons open a section directly:
#   fw-control-center [volume|wifi|bluetooth]
# Uses only what's installed: wpctl, nmcli, bluetoothctl. Display → fw-display-panel, Power → fw-power-panel.
set -euo pipefail

# Bar clicks set FW_BAR=1: open the menu below the clicked icon, closing any other menu (or this
# one, on a second click). From the keyboard it stays centred.
pos=()
if [[ -n ${FW_BAR:-} ]]; then
  mapfile -t pos < <(fw-menu-anchor "control-${1:-main}")
  (( ${#pos[@]} )) || exit 0
fi

# fuzzel allows one instance (a lock in $XDG_RUNTIME_DIR): the next prompt (e.g. the Wi-Fi password) fails silently if
# the previous menu hasn't exited yet. Wait for it, at most 2 s.
fuzzel_free() { local _; for _ in {1..40}; do pgrep -x fuzzel >/dev/null || return 0; sleep 0.05; done; }
menu() { fuzzel_free; fuzzel --dmenu "${pos[@]}" --prompt "$1 › " --lines "${2:-8}"; }

volume() {
  local cur pick
  cur="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%d%%%s", int($2 * 100 + 0.5), ($3 ? " muted" : "")}')"
  pick="$(printf '%s\n' "Mute on/off" 100% 75% 50% 25% "Settings…" | menu "Volume $cur" 6)" || return 0
  case $pick in
    Mute*) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    Sett*) fw-settings sound ;;
    *)     wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ "$pick" ;;
  esac
}

wifi() {
  local radio toggle nets pick ssid pw
  radio="$(nmcli radio wifi)"
  [[ $radio == enabled ]] && toggle="Turn Wi-Fi off" || toggle="Turn Wi-Fi on"
  # "● 87%  Name" per network, strongest first, one line per SSID (-e no: SSIDs keep their colons).
  # Cached list so the menu opens instantly; a background rescan freshens it for next time.
  nmcli dev wifi rescan >/dev/null 2>&1 &
  nets="$(nmcli -t -e no -f IN-USE,SIGNAL,SSID dev wifi list --rescan no 2>/dev/null \
    | awk -F: '{ s = substr($0, length($1) + length($2) + 3) } s != "" && !seen[s]++ {
        printf "%s %3s%%  %s\n", ($1 == "*" ? "●" : " "), $2, s }')"
  # The network in use goes first, spelled out, and in the prompt; the list below has the others.
  # The scan list's IN-USE flag is often missing, so the name comes from the Wi-Fi device's connection.
  local cur sig top=""
  cur="$(nmcli -t -e no -f TYPE,STATE,CONNECTION dev | awk -F: '$1 == "wifi" && $2 == "connected" { print substr($0, length($1) + length($2) + 3); exit }')"
  if [[ -n $cur ]]; then
    sig="$(printf '%s\n' "$nets" | awk -v s="$cur" '{ n = $0; sub(/^. +[0-9]+%  /, "", n) } n == s { sub(/%.*/, ""); print $NF; exit }')"
    top="✓  Connected: $cur${sig:+  ($sig%)}"
    nets="$(printf '%s\n' "$nets" | awk -v s="$cur" '{ n = $0; sub(/^. +[0-9]+%  /, "", n) } n != s')"
  fi
  pick="$(printf '%s\n%s\n%s\n%s' "$top" "$toggle" "Settings…" "$nets" | sed '/^$/d' \
    | menu "Wi-Fi${cur:+ · $cur}" 12)" || return 0
  case $pick in
    "✓  Connected:"*) return ;;
    "Turn Wi-Fi off") nmcli radio wifi off; return ;;
    "Turn Wi-Fi on")  nmcli radio wifi on; return ;;
    Sett*)            fw-settings network; return ;;
  esac
  ssid="${pick#*%  }"  # strip "● 87%  "
  if nmcli -g NAME connection show | grep -Fxq -- "$ssid"; then
    nmcli connection up id "$ssid" >/dev/null && fw-notify "Wi-Fi" "Connected to $ssid" || fw-notify "Wi-Fi" "Could not connect to $ssid"
    return
  fi
  # New network: fw13.net joins it (the same code as Settings → Network). The password reaches it on stdin, written
  # by bash's printf builtin, and nmcli through a 0600 passwd-file, so it is never on any command line.
  local net=(env PYTHONPATH="$HOME/.local/lib" python3 -m fw13.net) kind err
  kind="$("${net[@]}" security "$ssid" 2>&1)" || { fw-notify "Wi-Fi" "$ssid: $kind (Settings → Network → Advanced…)"; return; }
  pw=""
  if [[ $kind == password ]]; then
    fuzzel_free
    pw="$(fuzzel --dmenu "${pos[@]}" --password --prompt "Password for $ssid › " --lines 0)" || return 0
  fi
  if err="$(printf '%s' "$pw" | "${net[@]}" connect "$ssid" 2>&1)"; then
    fw-notify "Wi-Fi" "Connected to $ssid"
  else
    fw-notify "Wi-Fi" "Could not connect to $ssid${err:+: ${err##*$'\n'}}"
  fi
}

bluetooth() {
  local power pick ok=0 _ mac name bat label
  local -A macs=() connected=()
  local devs=()
  # Bluetooth switched off at the radio (rfkill soft block) removes the adapter: bluetoothctl then has no controller
  # and fails, which under set -e used to end the script before the menu opened. Treat that as "off".
  power="$(bluetoothctl show 2>/dev/null | awk '/Powered:/ {print $2; exit}')" || true
  # Connected devices first (with battery, like the Wi-Fi menu's "Connected" line), then the other paired
  # devices: picking one connects it. bluetoothctl also prints debug lines, hence the ^Device filter.
  if [[ $power == yes ]]; then
    while read -r _ mac name; do
      bat="$(bluetoothctl info "$mac" 2>/dev/null | awk -F'[()]' '/Battery Percentage/ {print $2; exit}')" || true
      label="✓  $name${bat:+  ($bat%)}"; connected[$mac]=1; devs+=("$label")
    done < <(bluetoothctl devices Connected 2>/dev/null | grep '^Device ' || true)
    while read -r _ mac name; do
      [[ -n ${connected[$mac]:-} ]] && continue
      label="    $name"; macs[$label]=$mac; devs+=("$label")
    done < <(bluetoothctl devices Paired 2>/dev/null | grep '^Device ' || true)
  fi
  pick="$(printf '%s\n' "${devs[@]}" "Turn $([[ $power == yes ]] && echo off || echo on)" "Settings…" | sed '/^$/d' \
    | menu "Bluetooth${connected[*]:+ · ${#connected[@]} connected}" $(( ${#devs[@]} + 2 > 10 ? 10 : ${#devs[@]} + 2 )))" || return 0
  if [[ -n ${macs[$pick]:-} ]]; then
    name="${pick#    }"
    if bluetoothctl connect "${macs[$pick]}" >/dev/null 2>&1; then fw-notify "Bluetooth" "Connected to $name"
    else fw-notify "Bluetooth" "Could not connect to $name (is it on and nearby?)"; fi
    return
  fi
  case $pick in
    "✓  "*) return ;;
    "Turn off") bluetoothctl power off >/dev/null 2>&1 || true ;;
    "Turn on")
      # Lift the radio block first (/dev/rfkill is writable by the seat user, as in fw13.bt), then power on;
      # bluetoothd sees the unblock a moment later, so retry for a few seconds.
      rfkill unblock bluetooth 2>/dev/null || true
      for _ in {1..25}; do
        if bluetoothctl power on >/dev/null 2>&1; then ok=1; break; fi
        sleep 0.2
      done
      (( ok )) || fw-notify "Bluetooth" "Couldn't turn Bluetooth on (no adapter found?) — see Settings → Bluetooth" ;;
    Sett*) fw-settings bluetooth ;;
  esac
}

main() {
  local pick
  pick="$(printf '%s\n' \
    $'  Volume' $'  Wi-Fi' $'  Bluetooth' $'\ue163  Display' \
    $'  Power' $'  Night light' $'  Lock / Suspend / Shut down' \
    | menu Control 7)" || return 0
  case $pick in
    *Volume)     volume ;;
    *Wi-Fi)      wifi ;;
    *Bluetooth)  bluetooth ;;
    *Display)    fw-display-panel ;;
    *Power)      fw-power-panel ;;
    *Night*)     fw-nightlight ;;
    *Shut*)      fw-system-menu ;;
  esac
}

case ${1:-} in
  "")                                     main ;;
  volume|wifi|bluetooth) "$1" ;;
  *) echo "usage: fw-control-center [volume|wifi|bluetooth]" >&2; exit 2 ;;
esac
