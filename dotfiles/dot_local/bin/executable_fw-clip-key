#!/usr/bin/env bash
# Copy / cut / paste in the focused window (SUPER+C, SUPER+X; paste for fw-clipboard and fw-emoji): sends the app's
# own shortcut with Hyprland's send_shortcut dispatcher. Terminals (by program, not window class: terminal windows may
# be fw13.btop, fw13.jarvis, …) get Ctrl+Shift+C/V; cut does nothing there (Ctrl+X is a real key for the shell).
# FW_CLIP_WINDOW=<address without 0x> targets a window captured earlier (before a menu took the focus) or in tests.
set -euo pipefail

action="${1:-}"
case "$action" in
  copy) key=c ;;
  cut)  key=x ;;
  paste) key=v ;;
  *) echo "usage: fw-clip-key copy|cut|paste" >&2; exit 2 ;;
esac

if [[ -n ${FW_CLIP_WINDOW:-} ]]; then
  addr="$FW_CLIP_WINDOW"
  info="$(hyprctl clients | awk -v w="Window $addr " 'index($0, w) == 1 { f = 1 } f { print } f && /^$/ { exit }')"
else
  info="$(hyprctl activewindow)"
  addr="$(awk '/^Window / { print $2; exit }' <<<"$info")"
fi
pid="$(awk -F': ' '/^\tpid:/ { print $2; exit }' <<<"$info")"
[[ -n $addr ]] || exit 0  # empty workspace

case "$(cat "/proc/$pid/comm" 2>/dev/null)" in
  kitty|foot|alacritty|ghostty|wezterm-gui|konsole|gnome-terminal-*|ptyxis*)
    [[ $action == cut ]] && exit 0
    mods="CTRL SHIFT" ;;
  *) mods="CTRL" ;;
esac
# Lua dispatcher (Hyprland Lua config). key must be lowercase: "V" is silently not delivered.
hyprctl dispatch "hl.dsp.send_shortcut({ mods = '$mods', key = '$key', window = 'address:0x$addr' })" >/dev/null
