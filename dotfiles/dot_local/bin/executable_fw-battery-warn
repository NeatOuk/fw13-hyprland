#!/usr/bin/env python3
"""Low-battery warnings (user service fw-battery-warn, Hyprland only; GNOME/KDE warn on their own).

Watches the battery over UPower D-Bus (PropertiesChanged, plus a 60 s check) and notifies once per discharge at
each level of store `battery_warn` (Settings → Power → On battery → Warn at; read on every check): 20 % normal,
10 and 5 % critical (stay until dismissed, shown under do-not-disturb: mako [app-name=fw-battery
urgency=critical]). Plugging in resets them. The 20 and 10 % notices offer Ask Jarvis (what's draining it).
On the same checks it puts the built-in panel at 60 Hz on battery and back when plugged in (displays.battery_rate).
Sleep report (store `sleep_report`, default on): logind's PrepareForSleep marks the battery % before and after a
sleep on battery; 10 s after waking (UPower catches up) it notifies "Asleep 7 h: used 4 %", and when the drain was
high while the hardware's deep-sleep time (/sys/power/suspend_stats/total_hw_sleep, readable without root) covers
under 80 % of it, says something kept the laptop from deep sleep.
Keyboard backlight: the Framework's keyboard controller turns it back on after a sleep (to the last Fn+Space level),
so the level from before the sleep is put back 2 and 8 s after waking; every change of it is logged
(journalctl --user -u fw-battery-warn) to tell the controller's changes from Fn+Space.
  fw-battery-warn            run
  fw-battery-warn enabled    exit 0 when the service should run (Hyprland, a battery)
  fw-battery-warn test       self-check of the threshold logic
"""
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.expanduser("~/.local/lib"))
from fw13 import displays, notify, power, store  # noqa: E402
from gi.repository import Gio, GLib  # noqa: E402  (versions pinned by fw13.notify / fw13.power)

APP = "fw-battery"
# UPower's critical action as GetCriticalAction reports it → what the laptop does at PercentageAction.
# "Sleep" (Auto on UPower 1.91) is logind's Sleep(): its SleepOperation= order, suspend-then-hibernate or suspend.
ACTIONS = {"PowerOff": "power off", "Hibernate": "hibernate", "HybridSleep": "hibernate", "Suspend": "suspend",
           "Sleep": "go to sleep (suspend, or hibernate if set up)"}


def step(pct, on_battery, levels, warned):
    """(level to warn about or None, new warned set). One warning per crossing; starting below several levels
    warns once, for the lowest."""
    if not on_battery:
        return None, frozenset()
    hit = {t for t in levels if pct <= t and t not in warned}
    return (min(hit) if hit else None), warned | hit


KBD = "/sys/class/leds/chromeos::kbd_backlight"


def kbd_level():
    try:
        with open(os.path.join(KBD, "brightness")) as f:
            return int(f.read())
    except (OSError, ValueError):
        return None


def restore_after_wake(before, now):
    """The level to put back after a wake, or None: only when the controller changed it."""
    return before if None not in (before, now) and now != before else None


HW_SLEEP = "/sys/power/suspend_stats/total_hw_sleep"  # µs in the deepest state, summed since boot


def sleep_report(pct0, pct1, secs, hw_usec):
    """(title, body) after a sleep of `secs` that went from pct0 to pct1 %, or None (short, or it charged)."""
    if secs < 1800 or pct1 > pct0:
        return None
    used, hours = pct0 - pct1, secs / 3600
    title = f"Asleep {power.duration(secs)}: used {used:.0f} %"
    body = f"{used / hours:.1f} % per hour"
    if hw_usec is not None and used / hours > 1 and hw_usec / 1e6 < 0.8 * secs:
        body += (f"; deep sleep only {hw_usec / 1e6 / secs:.0%} of the time: something kept the laptop awake "
                 "(a USB device, an app holding a wake lock)")
    return title, body


def read_hw_sleep():
    try:
        with open(HW_SLEEP) as f:
            return int(f.read())
    except (OSError, ValueError):
        return None


def jarvis_argv(pct, left):
    q = f"What's draining my battery? Battery at {pct} %" + (f", about {power.duration(left)} left" if left else "")
    return ["fw-jarvis-panel", "--ask", q + "."]


def action_text():
    act = power._call(power.UP, "/org/freedesktop/UPower", power.UP, "GetCriticalAction", None, "(s)")
    pct = 2
    try:
        for line in open("/etc/UPower/UPower.conf"):
            if line.startswith("PercentageAction="):
                pct = round(float(line.split("=", 1)[1]))
    except (OSError, ValueError):
        pass
    what = ACTIONS.get(act[0] if act else "", "power off (or hibernate if set up)")
    return f"the laptop will {what} at {pct} %"


class Watcher:
    def __init__(self):
        self.warned = frozenset()
        self.lowered = None  # panel rate we lowered from on battery; shortcut: forgotten on restart, then left at 60 Hz until replugged
        self.asks = {}  # notification id → Ask Jarvis argv
        notify.on_action(Gio.bus_get_sync(Gio.BusType.SESSION), self.acted)
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        for path in ("/org/freedesktop/UPower", power.battery_path()):
            self.bus.signal_subscribe(power.UP, "org.freedesktop.DBus.Properties", "PropertiesChanged", path,
                                      None, Gio.DBusSignalFlags.NONE, lambda *_: self.check())
        self.before = None  # (time, %, total_hw_sleep) when a sleep on battery began
        self.kbd_before = None  # keyboard backlight level when the sleep began
        self.kbd_seen = kbd_level()
        GLib.timeout_add_seconds(5, self.watch_kbd)
        self.bus.signal_subscribe("org.freedesktop.login1", "org.freedesktop.login1.Manager", "PrepareForSleep",
                                  "/org/freedesktop/login1", None, Gio.DBusSignalFlags.NONE,
                                  lambda _c, _s, _p, _i, _n, args: self.sleeping(args[0]))
        GLib.timeout_add_seconds(60, self.check)
        self.check()

    def check(self):
        b = power.battery()
        on = power._call(power.UP, "/org/freedesktop/UPower", "org.freedesktop.DBus.Properties", "Get",
                         GLib.Variant("(ss)", (power.UP, "OnBattery")), "(v)")
        if b and on is not None:
            levels = power.warn_levels()
            level, self.warned = step(b.get("Percentage", 100), on[0], levels, self.warned)
            if level is not None:
                self.warn(level, round(b["Percentage"]), b.get("TimeToEmpty", 0))
            self.lowered = displays.battery_rate(on[0], self.lowered)
        return True

    def on_battery(self):
        on = power._call(power.UP, "/org/freedesktop/UPower", "org.freedesktop.DBus.Properties", "Get",
                         GLib.Variant("(ss)", (power.UP, "OnBattery")), "(v)")
        return bool(on and on[0])

    def watch_kbd(self):
        level = kbd_level()
        if level != self.kbd_seen:
            print(f"keyboard backlight {self.kbd_seen} → {level}", flush=True)
            self.kbd_seen = level
        return True

    def restore_kbd(self):
        level = restore_after_wake(self.kbd_before, kbd_level())
        if level is not None:
            print(f"keyboard backlight turned on after waking: back to {level}", flush=True)
            subprocess.run(["brightnessctl", "-q", "-d", os.path.basename(KBD), "set", str(level)])
            self.kbd_seen = level
        return False

    def sleeping(self, going):
        if going:
            self.kbd_before = kbd_level()
        else:
            for delay in (2, 8):  # the controller may switch it on a few seconds after the wake
                GLib.timeout_add_seconds(delay, self.restore_kbd)
        b = power.battery()
        if going:
            self.before = (time.time(), b["Percentage"], read_hw_sleep()) if b and self.on_battery() else None
        elif self.before:
            GLib.timeout_add_seconds(10, self.woke, self.before)
            self.before = None

    def woke(self, before):
        t0, pct0, hw0 = before
        b, hw1 = power.battery(), read_hw_sleep()
        if b and self.on_battery() and store.get("sleep_report") is not False:
            hw = hw1 - hw0 if None not in (hw0, hw1) else None
            msg = sleep_report(pct0, b["Percentage"], time.time() - t0, hw)
            if msg:
                notify.send(APP, *msg, [], urgency=notify.NORMAL, icon="battery")
        return False

    def warn(self, level, pct, left):
        if level <= 5:
            title, body = f"Plug in now: {pct} %", action_text()
        else:
            title, body = f"Battery low: {pct} %", f"about {power.duration(left)} left" if left else ""
        actions = [("jarvis", "Ask Jarvis")] if level > 5 else []  # at 5 % the only advice is to plug in
        nid = notify.send(APP, title, body, actions, urgency=notify.NORMAL if level > 10 else notify.CRITICAL,
                          icon="battery-low" if level > 10 else "battery-caution")
        if nid and actions:
            self.asks[nid] = jarvis_argv(pct, left)

    def acted(self, nid, action):
        if action == "jarvis" and nid in self.asks:
            notify.launch(self.asks.pop(nid))


def selftest():
    assert restore_after_wake(0, 50) == 0 and restore_after_wake(30, 30) is None
    assert restore_after_wake(None, 50) is None and restore_after_wake(0, None) is None
    w, lv = frozenset(), (20, 10, 5)
    assert step(50, True, lv, w) == (None, w)
    level, w = step(19.6, True, lv, w)
    assert level == 20
    assert step(18, True, lv, w)[0] is None          # once per crossing
    level, w = step(10, True, lv, w)
    assert level == 10
    assert step(15, False, lv, w) == (None, frozenset())  # plugged in: reset
    assert step(7, True, lv, frozenset()) == (10, frozenset({20, 10}))  # unplugged low: one warning
    assert step(3, True, (), frozenset()) == (None, frozenset())  # Off
    plan, rates = displays.rate_plan, [120.0, 60.0]
    assert plan(rates, 120.0, True, True, None) == (60.0, 120.0)        # unplugged: down to 60, remember 120
    assert plan(rates, 60.0, True, True, 120.0) == (None, 120.0)        # already there
    assert plan(rates, 60.0, False, True, 120.0) == (120.0, None)       # plugged in: back
    assert plan(rates, 60.0, True, False, 120.0) == (120.0, None)       # setting turned off on battery: back
    assert plan(rates, 60.0, False, True, None) == (None, None)         # 60 Hz picked by hand: left alone
    assert plan([60.0], 60.0, True, True, None) == (None, None)         # 60 Hz-only panel
    assert sleep_report(80, 79, 600, 0) is None                          # short nap
    assert sleep_report(70, 75, 7200, 0) is None                         # charged meanwhile
    t, b = sleep_report(80, 76, 7 * 3600, 7 * 3600 * 1e6)
    assert t.startswith(f"Asleep {power.duration(7 * 3600)}: used 4 %") and "deep sleep" not in b
    assert "deep sleep only 25%" in sleep_report(80, 60, 4 * 3600, 3600 * 1e6)[1]   # high drain, little deep sleep
    assert "deep sleep" not in sleep_report(80, 79, 8 * 3600, 3600 * 1e6)[1]   # hibernated: low drain, no blame
    assert jarvis_argv(18, 0) == ["fw-jarvis-panel", "--ask", "What's draining my battery? Battery at 18 %."]
    assert jarvis_argv(9, 1800)[2].endswith(f"9 %, about {power.duration(1800)} left.")
    print("ok")


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "run"
    if cmd == "test":
        selftest()
    elif cmd == "enabled":
        sys.exit(0 if notify.in_hyprland() and power.battery_path() else 1)
    else:
        Watcher()
        GLib.MainLoop().run()
