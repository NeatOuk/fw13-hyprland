#!/usr/bin/env python3
"""Notification bell: history, do-not-disturb, dismiss all (mako).

  fw-notifications          menu (bar bell with FW_BAR=1 → opens below it): do-not-disturb on/off, dismiss all,
                            then the notifications, newest first; picking one copies its text
  fw-notifications --bar    waybar JSON (custom/notifications, signal 12): bell + unread count, bell-slash under DND
  fw-notifications --dnd    toggle do-not-disturb (bar right-click)

Unread = notifications newer than the `notif_seen` mark in fw13.store ({"mako": <pid>:<start time>, "id": N}, set
when the menu opens). mako numbers notifications from 1 again after a restart, so the mark resets when the mako
process it was taken from is gone (not when ids drop: `makoctl dismiss -h` or an app closing its own notification
removes the newest without a restart).
mako's global on-notify signals the bar; fw-osd popups (history=0, on-notify=none) are left out everywhere.
"""
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.expanduser("~/.local/lib"))

from fw13.mako import (bar_refresh, copy, dnd_on, everything, makoctl, mark_seen,  # noqa: E402
                       plain_text, seen_mark, toggle_dnd)

BELL, BELL_SLASH = "", ""  # Font Awesome 6 Free: bell, bell-slash


# --- bar ----------------------------------------------------------------------------------------
def bar():
    items = everything()
    mark = seen_mark()
    unread = sum(n["id"] > mark for n in items)
    if dnd_on():
        text, cls = BELL_SLASH, "dnd"
        tip, hint = "Do not disturb is on", "turn it off"
    else:
        text, cls = BELL, "unread" if unread else ""
        tip, hint = "Notifications", "do not disturb"
    if unread:
        text += f" {unread}"
        tip += f" · {unread} new"
    print(json.dumps({"text": text, "tooltip": tip + f"\nRight-click: {hint}", "class": cls}))


# --- menu ---------------------------------------------------------------------------------------
def fuzzel(rows, prompt, pos):
    # fuzzel allows one instance (a lock in $XDG_RUNTIME_DIR): wait for a closing one, at most 2 s.
    for _ in range(40):
        if subprocess.run(["pgrep", "-x", "fuzzel"], capture_output=True).returncode:
            break
        time.sleep(0.05)
    r = subprocess.run(["fuzzel", "--dmenu", "--index", *pos, "--prompt", f"{prompt} › ", "--width", "64",
                        "--lines", str(min(len(rows), 14))],
                       input="\n".join(rows), capture_output=True, text=True)
    try:
        return int(r.stdout.strip()) if r.returncode == 0 else None
    except ValueError:
        return None


def row(n):
    text = " — ".join(t for t in (plain_text(n["summary"]), plain_text(n["body"])) if t)
    text = " ".join(text.split())  # one line
    if len(text) > 90:
        text = text[:89] + "…"
    return f"{n['app'] or 'Notification'} · {text}" if text else (n["app"] or "Notification")


def menu(pos):
    items = everything()
    if items:  # opening the menu marks everything as read
        mark_seen(max(n["id"] for n in items))
        bar_refresh()
    dnd = dnd_on()
    rows = [f"{BELL if dnd else BELL_SLASH}  Turn do not disturb {'off' if dnd else 'on'}",
            "  Dismiss all"]  # xmark
    rows += [row(n) for n in items] or ["No notifications"]
    pick = fuzzel(rows, "Notifications", pos)
    if pick is None:
        return
    if pick == 0:
        toggle_dnd()
    elif pick == 1:
        makoctl("dismiss", "--all")
    elif 2 <= pick < 2 + len(items):
        n = items[pick - 2]
        copy("\n".join(t for t in (plain_text(n["summary"]), plain_text(n["body"])) if t))


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--bar":
        bar()
    elif arg == "--dnd":
        toggle_dnd()
    elif arg == "":
        pos = []
        if os.environ.get("FW_BAR"):
            pos = subprocess.run(["fw-menu-anchor", "notifications"], capture_output=True, text=True).stdout.split("\n")
            pos = [p for p in pos if p]
            if not pos:
                return 0  # second click on the bell: menu closed
        menu(pos)
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
