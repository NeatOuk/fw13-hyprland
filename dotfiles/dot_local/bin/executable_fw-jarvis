#!/usr/bin/env bash
# Jarvis: ask an AI agent — Claude Code, or the coding agent (OpenCode or Pi, Settings → Coding agent) on any
# Ollama server from the >_ panel — about
# this computer or the fw13-hypr repo. Tasks open in a floating terminal window (class fw13.jarvis; kitty or Ghostty via fw-term).
#   fw-jarvis                  the Jarvis panel (SUPER+A): ask and the answer appears inline (fw-jarvis-panel)
#   fw-jarvis crash | repo <agent> <task> | open claude|agent   the panel's buttons (opencode = agent)
#   fw-jarvis diagnose <file>  explain a crash report (fw-crash-watch) or a daily health report (fw-health)
#   fw-jarvis shot             pick a region (slurp), ask about it (SUPER+ALT+A)
#   fw-jarvis selection        ask about the selected text (SUPER+CTRL+A)
# Ask/Diagnose run in ~/jarvis (created if missing), whose AGENTS.md/CLAUDE.md brief the agent on this OS.
set -euo pipefail

JDIR="$HOME/jarvis"
mkdir -p "$JDIR"
[[ -e $JDIR/MEMORY.md ]] || : > "$JDIR/MEMORY.md"  # the owner's notes, imported by CLAUDE.md; never a chezmoi target
CRASHES="${XDG_RUNTIME_DIR:-/tmp}/jarvis"
REPO="$HOME/.local/share/fw13-hypr"
for d in "$HOME/claude/fw13-hyprland" "$HOME/fw13-hyprland"; do   # owner's clone
  [[ -d $d/.git ]] && { REPO=$d; break; }
done

mkdir -p "$CRASHES"
LOG="$CRASHES/jarvis.log"
log() { printf '%s %s\n' "$(date +%T)" "$*" >> "$LOG"; }  # each step, so "nothing happened" can be traced

# launch <dir> <target> [prompt] — with a prompt it's a Jarvis task (floating window, class fw-jarvis);
# without one it's a plain Claude/coding-agent session that tiles like any terminal.
launch() {
  local dir=$1 target=$2 prompt=${3:-} cmd class=() cargs=()
  if [[ $target == claude ]]; then
    mapfile -t cargs < <(PYTHONPATH="$HOME/.local/lib" python3 -m fw13.jarvis 2>/dev/null || true)  # Settings → Jarvis: --model/--effort
    cmd=(claude "${cargs[@]}" ${prompt:+"$prompt"})
  else  # OpenCode or Pi (fw13.agents); target agent/opencode = its default model, provider/model = that one
    mapfile -d '' -t cmd < <(PYTHONPATH="$HOME/.local/lib" python3 -m fw13.agents session "$target" ${prompt:+"$prompt"})
    (( ${#cmd[@]} )) || { fw-notify "Jarvis" "Could not start the coding agent"; return 1; }
  fi
  # Tasks keep their window when the agent exits (--hold), so an error stays readable instead of a window
  # that flashes and closes.
  [[ -n $prompt ]] && class=(--class fw13.jarvis --hold)
  log "launch in $dir: ${cmd[0]} (${#prompt} chars of prompt)"
  uwsm app -- fw-term "${class[@]}" --dir "$dir" -e "${cmd[@]}" >>"$LOG" 2>&1 &
}

diagnose() {
  local file=$1
  [[ -r $file ]] || { fw-notify "Jarvis" "Report not found"; return; }
  # The Jarvis panel answers inline and right away; fixes come as Run/Skip cards (nothing runs without a click).
  exec fw-jarvis-panel --ask "Read the report at $file (a crash report or a daily health report), then check \
whatever else helps (journalctl, coredumpctl info, the app's own log files). Explain in plain words what needs \
attention and the most likely cause. If there's a fix, propose it as action cards, one step at a time."
}

shot() {
  local g f="${XDG_RUNTIME_DIR:-/tmp}/fw-jarvis-shot.png"
  g="$(slurp)" || exit 0
  rm -f "$f"
  (umask 077; grim -g "$g" "$f")  # 0600, replaced each time
  exec fw-jarvis-panel --image "$f"
}

last_crash() {
  local last
  last="$(ls -t "$CRASHES"/crash-*.md 2>/dev/null | head -1)" || true
  if [[ -n $last ]]; then diagnose "$last"; else fw-notify "Jarvis" "No crash reports since login"; fi
}

# No argument: the Jarvis panel (inline answers; fw-jarvis-panel). Its buttons come back here.
case ${1:-} in
  "")       exec fw-jarvis-panel ;;
  diagnose) diagnose "${2:?usage: fw-jarvis diagnose <file>}" ;;
  crash)    last_crash ;;
  repo)     launch "$REPO" "${2:?usage: fw-jarvis repo <agent> <task>}" "${3:?usage: fw-jarvis repo <agent> <task>}" ;;
  open)     launch "$JDIR" "${2:-claude}" ;;
  shot)     shot ;;
  selection) exec fw-jarvis-panel --text-from-selection ;;
  *) echo "usage: fw-jarvis [diagnose <file> | crash | repo <agent> <task> | open claude|agent | shot | selection]" >&2; exit 2 ;;
esac
